{
  "name": "clickup-mcp-server",
  "version": "4.3.1",
  "description": "A Model Context Protocol (MCP) server for ClickUp: 18 tools addressed by name rather than ID, with capability profiles that make it safe to hand to an untrusted agent",
  "main": "build/v4/index.js",
  "files": [
    "build",
    "scripts",
    "CHANGELOG.md"
  ],
  "bin": {
    "clickup-mcp-server": "./build/v4/index.js",
    "clickup-mcp-server-v3": "./build/index.js",
    "clickup-mcp-receiver": "./build/webhook-receiver/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm src/v4/index.ts",
    "start": "node build/v4/index.js",
    "start:v3": "node build/index.js",
    "check": "node build/v4/index.js --check",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node test/smoke.mjs",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "node scripts/prepare.mjs",
    "dev:v3": "ts-node --esm src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benthesoundguy/clickup-mcp-server.git"
  },
  "keywords": [
    "clickup",
    "mcp",
    "model-context-protocol",
    "ai",
    "assistant",
    "api",
    "server"
  ],
  "author": "benthesoundguy",
  "contributors": [
    "David Whatley (https://davidwhatley.com) \u2014 original clickup-mcp-server author",
    "ClickUp MCP Server Contributors"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/benthesoundguy/clickup-mcp-server/issues"
  },
  "homepage": "https://github.com/benthesoundguy/clickup-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^18.19.26",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
